<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ตั้งแต่ Android 12 (API 31) แอปที่ไม่ประกาศสิทธิ์นี้จะอ่านเซนเซอร์ได้ไม่เกิน 200 Hz
         แต่ ARCore ต้องใช้ IMU ที่ 400-500 Hz ถ้าขาดไป motion tracking จะค้างที่ PAUSED
         ตลอดและไม่ตรวจจับรูป marker เลย (เป็น normal permission ระบบให้ตั้งแต่ตอนติดตั้ง) -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- แอปนี้ทำงานไม่ได้เลยถ้าเครื่องไม่รองรับ ARCore จึงตั้ง required=true
         เพื่อให้ Play Store ซ่อนแอปจากเครื่องที่ใช้ไม่ได้ -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SensorAR">

        <!-- required = ให้ Play ติดตั้ง Google Play Services for AR ให้อัตโนมัติ -->
        <meta-data android:name="com.google.ar.core" android:value="required" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SensorAR">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
