# ---------------------------------------------------------------------------
# MQTT broker (server-side subscriber)
# ---------------------------------------------------------------------------
# ใส่ host ของ broker ที่รันอยู่ในเครื่อง / ในวง LAN
# รองรับ mqtt:// (1883), mqtts:// (8883), ws:// , wss://
# embedded = เว็บนี้เป็น MQTT broker เอง (ไม่ต้องติดตั้ง Mosquitto)
# external = ไปเป็น client ของ broker ตัวอื่นตาม MQTT_URL
MQTT_MODE=embedded

# พอร์ตที่ broker ในตัวจะเปิดรอ (ใช้เฉพาะโหมด embedded)
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_BIND_HOST=0.0.0.0

# ใช้เฉพาะโหมด external
MQTT_URL=mqtt://localhost:1883

# หัวข้อที่จะ subscribe คั่นด้วย comma รองรับ wildcard + และ #
# ต้องใส่เครื่องหมายคำพูดถ้ามี # ไม่งั้นจะถูกตัดทิ้งเพราะถูกมองเป็นคอมเมนต์
MQTT_TOPICS="sensors/#"

# ไม่ต้องใส่ถ้า broker เปิดแบบ anonymous (ใช้ภายใน)
# MQTT_USERNAME=
# MQTT_PASSWORD=

# client id prefix ที่จะใช้ต่อกับ random suffix
MQTT_CLIENT_ID=weather-dashboard

# ---------------------------------------------------------------------------
# ตำแหน่งที่ตั้งของสถานี (ใช้กับพยากรณ์อากาศ + คำนวณระยะแผ่นดินไหว)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=สถานีตรวจวัด 1
NEXT_PUBLIC_SITE_LAT=13.7563
NEXT_PUBLIC_SITE_LON=100.5018

# รัศมีที่ถือว่าแผ่นดินไหว "ใกล้" (กิโลเมตร) และแมกนิจูดขั้นต่ำที่จะแจ้งเตือน
EARTHQUAKE_RADIUS_KM=1500
EARTHQUAKE_MIN_MAGNITUDE=4.0

# ---------------------------------------------------------------------------
# เกณฑ์แจ้งเตือนค่า sensor
# ---------------------------------------------------------------------------
ALERT_TEMPERATURE_MAX=40
ALERT_TEMPERATURE_MIN=5
ALERT_HUMIDITY_MAX=85
ALERT_HUMIDITY_MIN=20
ALERT_VIBRATION_MAX=2.5
# ความสว่างจาก LDR (lux) — ค่าเริ่มต้นกว้างมากจนไม่แจ้งเตือน ปรับให้แคบลงถ้าต้องการ
ALERT_LIGHT_MIN=0
ALERT_LIGHT_MAX=100000

# ---------------------------------------------------------------------------
# Node-RED — ปลายทางที่จะส่งข้อมูลต่อเพื่อออกเป็น Excel
# ---------------------------------------------------------------------------
# URL ของ http-in node ใน Node-RED (ดูตัวอย่าง flow ที่ nodered/flow.json)
NODERED_URL=http://localhost:1880/sensor-data
# ส่งเป็นชุด ทุก ๆ กี่มิลลิวินาที และไม่เกินกี่ record ต่อชุด
NODERED_FLUSH_MS=10000
NODERED_BATCH_SIZE=200
# ตั้งเป็น false เพื่อปิดการส่งชั่วคราว
NODERED_ENABLED=true
# ถ้า Node-RED ตั้ง http-in ให้ต้องมี token
# NODERED_TOKEN=

# ---------------------------------------------------------------------------
# จำนวนจุดข้อมูลสูงสุดที่เก็บใน memory ต่อ 1 metric
# ---------------------------------------------------------------------------
HISTORY_SIZE=5000
# ---------------------------------------------------------------------------
# รับข้อมูลเฉพาะอุปกรณ์ที่ระบุ (คั่นด้วย comma) เว้นว่าง = รับทุกอุปกรณ์
# ค่าที่มาจากอุปกรณ์นอกรายการจะถูกทิ้ง ไม่เก็บและไม่ส่งต่อ Node-RED
# ---------------------------------------------------------------------------
DEVICE_ALLOWLIST=dev-A,dev-B,dev-C,dev-D,dev-E,dev-F
